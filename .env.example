# App queries — Supabase transaction pooler (port 6543, for Vercel/serverless)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require&schema=public"

# Optional but recommended on Vercel — session pooler (port 5432) used only for migrate deploy
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&schema=public"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Mail — Mailpit locally; swap SMTP_* for real provider in prod
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="Hearth <noreply@hearth.local>"
SMTP_SECURE="false"
# SMTP_USER=
# SMTP_PASS=
